{
  "expo": {
    "name": "Memes Database",
    "slug": "memes-database",
    "scheme": "memesdatabase",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["web", "ios", "android"],
    "plugins": ["expo-router"],
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piratechs.memesdatabase"
    },
    "android": {
      "package": "com.piratechs.memesdatabase"
    }
  }
}
